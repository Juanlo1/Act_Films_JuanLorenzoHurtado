<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Google Movies</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  
  <div class="home-container">
    <div class="google-logo">
      <span class="g-blue">G</span>
      <span class="g-red">o</span>
      <span class="g-yellow">o</span>
      <span class="g-blue">g</span>
      <span class="g-green">l</span>
      <span class="g-red">e</span>
    </div>

    <form action="/search" method="GET" class="search-form">
      <div class="input-container">
        <input type="text" name="pelis" placeholder="Escribe el nombre de la pelicula..." required>
      </div>
      <button type="submit" class="btn-search">Buscar con Google</button>
    </form>
  </div>
</body>
</html>